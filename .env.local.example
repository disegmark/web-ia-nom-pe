# Copia este archivo a .env.local y completa los valores reales.
# Nunca subas .env.local al repositorio ni expongas estas claves al navegador.

# --- Formulario de contacto (server-only) ---
# URL de un servicio propio (email transaccional, webhook de CRM, etc.) que
# reciba las solicitudes del formulario de /contacto. Si se omite, las
# solicitudes solo quedan registradas en el log del servidor.
CONTACT_NOTIFY_URL=
CONTACT_NOTIFY_API_KEY=

# --- Chatbot web (server-only) ---
# Clave de la API de Anthropic que alimenta el widget de chat en /api/chat.
# Sin esta variable, el widget queda visible pero muestra un aviso y
# redirige a WhatsApp en vez de responder. Nunca la expongas con el
# prefijo NEXT_PUBLIC_.
ANTHROPIC_API_KEY=

# --- Futuro: capa de agentes / plataforma iA Empresarial 360 ---
# Reservado para cuando se integren más proveedores, bases de
# conocimiento (RAG), CRM u orquestadores (n8n). No usar el prefijo
# NEXT_PUBLIC_ en ninguna clave secreta.
# OPENAI_API_KEY=
# CRM_API_URL=
# CRM_API_KEY=
